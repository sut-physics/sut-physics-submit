# ============================================================
# ต้นแบบของ .env — ก๊อปเป็น `.env` แล้วเติมค่าจริง (`.env` ไม่ขึ้น git)
#   cp .env.example .env
# คำอธิบายแต่ละค่า + วิธีแก้ปัญหาที่เคยเจอ ดู deploy/OPERATIONS.md
# ============================================================

# ---------- Oracle Cloud VM ----------
VM_HOST=<public ip ของ VM>
VM_USER=ubuntu
VM_SSH_KEY=~/path/to/ssh-key            # ต้อง chmod 600 ไม่งั้น ssh ปฏิเสธ

# ---------- เว็บ / PocketBase ----------
PB_URL=https://<ชื่อเครื่อง>.<tailnet>.ts.net
PB_ADMIN_UI=https://<ชื่อเครื่อง>.<tailnet>.ts.net/_/
PB_SUPERUSER_EMAIL=<อีเมล superuser>
PB_SUPERUSER_PASSWORD=<รหัส superuser>  # ควรอยู่ใน password manager ด้วย

# ---------- Tailscale Funnel ----------
TS_ACCOUNT=<บัญชีที่ล็อกอิน tailscale>
TS_MACHINE=submit
TS_TAILNET=<tailnet>.ts.net
TS_IP=<100.x.y.z>

# ---------- เข้ารหัส backup (age) ----------
# กุญแจล็อก (public) — ไม่ลับ ใส่ค่าจริงได้
BACKUP_RECIPIENT=age1<กุญแจล็อก>
# กุญแจไข (private) — **ใส่แค่ path เท่านั้น ห้ามเอาค่าจริงมาไว้ในไฟล์นี้**
# เหตุผล: ไฟล์นี้อยู่ในโฟลเดอร์ repo พลาด `git add -f` ครั้งเดียวคือหลุด
#         และถ้าไฟล์เดียวหาย จะเสียทั้ง backup ทั้ง credential พร้อมกัน
BACKUP_KEY_FILE=~/submit-backup-key.txt

# ---------- NAS (ปลายทาง backup) ----------
NAS_HOST=<ip ของ NAS>
NAS_SHARE=/volume2/submit-backups
NAS_SSH_PORT=443                        # ไม่ใช่ 22 — เครือข่ายของ NAS บล็อก SSH ขาออก
NAS_WEB=http://<ip ของ NAS>:8088/

# ---------- GitHub ----------
GH_REPO=<org>/<repo>
